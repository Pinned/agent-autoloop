{
  "name": "agent-autoloop-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/start.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "runtime:check": "node scripts/runtime-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
